rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidNoteId(noteId) {
      return noteId is string && noteId.size() <= 128;
    }

    // Public share check for single note reading
    function isSharedAndActive(noteData) {
      return noteData.shared == true &&
        (noteData.shareExpiresAt == null || request.time < noteData.shareExpiresAt);
    }

    // User Profile Rules
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // User's Notes Subcollection
      match /notes/{noteId} {
        // Single note read: Owner can always read; Public can read ONLY if note is shared and unexpired
        allow get: if isOwner(userId) || (resource != null && isSharedAndActive(resource.data));

        // Listing notes: Only the authenticated owner can list their notes collection
        allow list: if isOwner(userId);

        // Create, Update, Delete: Restricted strictly to the note owner
        allow create: if isOwner(userId) && isValidNoteId(noteId);
        allow update: if isOwner(userId);
        allow delete: if isOwner(userId);
      }
    }
  }
}
